# Managed by Portillo.Dots.
# GNU ls colors for terminals using the Kanagawa Dragon palette.
#
# Most entries retain the standard GNU dircolors mappings, which Alacritty
# renders through the official Kanagawa Dragon ANSI palette. Permission-marked
# directories use semantic Kanagawa colors with audited contrast against the
# Dragon background (#181616).

COLORTERM ?*
TERM Eterm
TERM alacritty*
TERM ansi
TERM *color*
TERM con[0-9]*x[0-9]*
TERM cons25
TERM console
TERM cygwin
TERM *direct*
TERM dtterm
TERM foot
TERM gnome
TERM hurd
TERM jfbterm
TERM konsole
TERM kterm
TERM linux
TERM linux-c
TERM mlterm
TERM putty
TERM rxvt*
TERM screen*
TERM st
TERM terminator
TERM tmux*
TERM vt100
TERM wezterm*
TERM xterm*

RESET 0
DIR 01;34
LINK 01;36
MULTIHARDLINK 00
FIFO 40;33
SOCK 01;35
DOOR 01;35
BLK 40;33;01
CHR 40;33;01
ORPHAN 40;31;01
MISSING 00
# Kanagawa black (#0d0c0c) on bright red (#e46876), contrast 6.08:1.
SETUID 38;2;13;12;12;48;2;228;104;118
SETGID 30;43
CAPABILITY 00

# World-writable directories: bright red (#e46876), bold, no background.
STICKY_OTHER_WRITABLE 01;38;2;228;104;118
OTHER_WRITABLE 01;38;2;228;104;118

# Sticky without world-write is a protected special state, not the same risk.
# Kanagawa bright yellow (#e6c384), bold, no background; contrast 10.73:1.
STICKY 01;38;2;230;195;132

EXEC 01;32

# Archives and packages: Kanagawa orange (#b6927b), contrast 6.34:1.
.tar 38;2;182;146;123
.tgz 38;2;182;146;123

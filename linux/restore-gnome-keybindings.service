[Unit]
Description=Reaplica keybindings de GNOME y configuración de Forge al login
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/bin/bash -lc '__REPO__/linux/restore-gnome-keybindings.sh'
RemainAfterExit=no

[Install]
WantedBy=graphical-session.target

[Unit]
Description=Apply Linux hardware optimizations (CPU governor, swappiness, fan policy)
# NO usar Before=multi-user.target: combinado con After=power-profiles-daemon
# (que multi-user.target ya pulls-in) crea un ordering cycle y systemd BORRA el
# job de este servicio en el boot ("Found ordering cycle ... Job ... deleted").
# Sin Before=multi-user.target el servicio corre después de PPD, sin ciclo.
After=sysinit.target power-profiles-daemon.service
Wants=power-profiles-daemon.service
ConditionPathExists=/usr/local/bin/apply-linux-hardware-settings.sh

[Service]
Type=oneshot
ExecStart=/usr/local/bin/apply-linux-hardware-settings.sh --apply
RemainAfterExit=yes
# Safety net: si powerprofilesctl o cualquier comando se cuelga, abortamos
# en lugar de bloquear el boot indefinidamente.
TimeoutStartSec=20

[Install]
WantedBy=multi-user.target
